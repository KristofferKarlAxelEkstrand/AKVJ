{
	"ignore": [".agents/**"],
	"workspaces": {
		".": {
			"entry": ["e2e/**/*.spec.js", "monorepo-scripts/test/**/*.test.js"],
			"project": ["e2e/**/*.js", "monorepo-scripts/**/*.js"]
		},
		"akvj": {
			"entry": ["test/**/*.test.js"],
			"project": ["src/**/*.js", "test/**/*.js"],
			"ignore": ["src/tools/clip-preview/ClipPreview.js"]
		},
		"mainframe": {
			"entry": ["test/**/*.test.js", "test/smoke/**/*.smoke.js"],
			"project": ["src/**/*.js", "server/**/*.js", "scripts/**/*.js", "test/**/*.js"]
		}
	},
	"ignoreBinaries": ["pkill", "ss"]
}
