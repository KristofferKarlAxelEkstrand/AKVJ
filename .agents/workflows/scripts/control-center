#!/bin/bash
# control-center — interactive dashboard for AI agent team management

WORKFLOWS_DIR="/workspaces/AKVJ/.agents/workflows"
AKVJ_ROOT="/workspaces/AKVJ"
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
RUN_TEAM="$SCRIPT_DIR/run-team"
REFRESH_SECONDS=5

# Colors
G='\033[0;32m'   # green
Y='\033[1;33m'   # yellow
R='\033[0;31m'   # red
C='\033[0;36m'   # cyan
B='\033[1m'      # bold
D='\033[2m'      # dim
N='\033[0m'      # reset

cd "$AKVJ_ROOT" || { echo "Error: Cannot cd to $AKVJ_ROOT"; exit 1; }

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

get_all_workflows() {
    for dir in "$WORKFLOWS_DIR"/*/; do
        [ -d "$dir" ] || continue
        local name
        name=$(basename "$dir")
        [ "$name" != "scripts" ] && echo "$name"
    done
}

session_name() { echo "${1}-agents"; }

is_running() { tmux has-session -t "$(session_name "$1")" 2>/dev/null; }

agent_count() {
    tmux list-panes -t "$(session_name "$1"):agents" 2>/dev/null | wc -l | tr -d ' '
}

outbox_files() {
    local dir="$WORKFLOWS_DIR/$1/mail/out"
    [ -d "$dir" ] || return
    find "$dir" -maxdepth 1 -type f \( -name "*.md" -o -name "*.json" \) \
        ! -name "README.md" ! -name ".gitkeep" 2>/dev/null | sort
}

outbox_count() { outbox_files "$1" | wc -l | tr -d ' '; }

tmux_go() {
    # switch-client when already inside tmux, attach otherwise
    if [ -n "$TMUX" ]; then
        tmux switch-client -t "$1"
    else
        tmux attach -t "$1"
    fi
}

# ---------------------------------------------------------------------------
# Screen
# ---------------------------------------------------------------------------

draw() {
    clear
    mapfile -t workflows < <(get_all_workflows)

    echo -e "${B}╔══════════════════════════════════════════╗${N}"
    echo -e "${B}║       AKVJ Team Control Center           ║${N}"
    echo -e "${B}╚══════════════════════════════════════════╝${N}"
    echo ""

    # Teams
    echo -e "${B} TEAMS${N}"
    if [ ${#workflows[@]} -eq 0 ]; then
        echo -e "  ${D}No workflows found in $WORKFLOWS_DIR${N}"
    else
        for wf in "${workflows[@]}"; do
            if is_running "$wf"; then
                local n
                n=$(agent_count "$wf")
                echo -e "  ${G}●${N} ${B}$wf${N}  ${D}$n agents${N}"
            else
                echo -e "  ${D}○ $wf  stopped${N}"
            fi
        done
    fi
    echo ""

    # Outbox mail
    local any_mail=false
    for wf in "${workflows[@]}"; do
        local count
        count=$(outbox_count "$wf")
        if [ "$count" -gt 0 ] 2>/dev/null; then
            if ! $any_mail; then
                echo -e "${Y}${B} MAIL WAITING FOR YOU${N}"
                any_mail=true
            fi
            echo -e "  ${Y}!${N} ${B}$wf${N}  $count message(s)"
            outbox_files "$wf" | while IFS= read -r f; do
                echo -e "    ${D}→ $(basename "$f")${N}"
            done
        fi
    done
    $any_mail && echo ""

    echo -e "${D}──────────────────────────────────────────${N}"
    echo -e "  ${C}s${N} Start   ${C}q${N} Stop   ${C}a${N} Attach   ${C}r${N} Restart   ${C}x${N} Exit"
    echo -e "${D}──────────────────────────────────────────${N}"
    echo -ne "  Key or wait ${REFRESH_SECONDS}s to refresh... "
}

# ---------------------------------------------------------------------------
# Pick a team from a filtered list. Prints the chosen name or nothing.
# ---------------------------------------------------------------------------

pick_team() {
    local label="$1"
    shift
    local options=("$@")

    if [ ${#options[@]} -eq 0 ]; then
        echo -e "\n  ${D}No teams available.${N}\n" >&2
        sleep 1.5
        return
    fi

    if [ ${#options[@]} -eq 1 ]; then
        echo "${options[0]}"
        return
    fi

    # All UI goes to stderr so the caller can capture only the result via $()
    echo -e "\n  $label" >&2
    for i in "${!options[@]}"; do
        echo -e "    $((i+1)). ${options[$i]}" >&2
    done
    echo -ne "  Number: " >&2
    local sel
    read -r sel
    local idx=$((sel - 1))
    if [[ "$sel" =~ ^[0-9]+$ ]] && [ -n "${options[$idx]}" ]; then
        echo "${options[$idx]}"
    fi
}

# ---------------------------------------------------------------------------
# Actions
# ---------------------------------------------------------------------------

do_start() {
    local stopped=()
    for wf in $(get_all_workflows); do
        is_running "$wf" || stopped+=("$wf")
    done
    local target
    target=$(pick_team "Start which team?" "${stopped[@]}")
    [ -n "$target" ] && "$RUN_TEAM" "$target"
}

do_stop() {
    local running=()
    for wf in $(get_all_workflows); do
        is_running "$wf" && running+=("$wf")
    done
    local target
    target=$(pick_team "Stop which team?" "${running[@]}")
    if [ -n "$target" ]; then
        echo -ne "  Stopping $target... "
        tmux kill-session -t "$(session_name "$target")" 2>/dev/null
        echo -e "${G}done${N}"
        sleep 1
    fi
}

do_attach() {
    local running=()
    for wf in $(get_all_workflows); do
        is_running "$wf" && running+=("$wf")
    done
    local target
    target=$(pick_team "Attach to which team?" "${running[@]}")
    [ -n "$target" ] && tmux_go "$(session_name "$target")"
}

do_restart() {
    local running=()
    for wf in $(get_all_workflows); do
        is_running "$wf" && running+=("$wf")
    done
    local target
    target=$(pick_team "Restart which team?" "${running[@]}")
    [ -n "$target" ] && "$RUN_TEAM" "$target"
}

# ---------------------------------------------------------------------------
# Main loop
# ---------------------------------------------------------------------------

while true; do
    draw
    key=""
    read -r -t "$REFRESH_SECONDS" -n 1 key
    case "$key" in
        s|S) clear; do_start ;;
        q|Q) clear; do_stop ;;
        a|A) clear; do_attach ;;
        r|R) clear; do_restart ;;
        x|X) clear; exit 0 ;;
    esac
done
