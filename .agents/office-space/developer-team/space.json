{
  "schemaVersion": 1,
  "name": "developer-team",
  "default": true,
  "repositoryRoot": "../../..",
  "state": {
    "records": "records",
    "checkpointOnStages": [
      "human",
      "blocked"
    ]
  },
  "tasks": {
    "stages": [
      "queued",
      "implementing",
      "review",
      "qa",
      "human",
      "blocked",
      "done"
    ],
    "transitions": {
      "queued": [
        "implementing",
        "blocked"
      ],
      "implementing": [
        "review",
        "blocked"
      ],
      "review": [
        "implementing",
        "qa",
        "blocked"
      ],
      "qa": [
        "implementing",
        "done",
        "human",
        "blocked"
      ],
      "human": [
        "implementing",
        "done",
        "blocked"
      ],
      "blocked": [
        "implementing",
        "review",
        "qa",
        "human"
      ],
      "done": []
    }
  },
  "messages": {
    "types": [
      "task",
      "report",
      "blocked",
      "feedback",
      "approved",
      "rejected",
      "nit",
      "test",
      "deps",
      "npm-request",
      "prompt-updated",
      "question",
      "bug",
      "feature",
      "review",
      "answer",
      "handoff",
      "run-request"
    ]
  },
  "review": {
    "machineChecks": [
      {
        "label": "lint",
        "command": [
          "npm",
          "run",
          "lint"
        ]
      },
      {
        "label": "unit",
        "command": [
          "npm",
          "run",
          "test"
        ]
      },
      {
        "label": "build",
        "command": [
          "npm",
          "run",
          "build"
        ]
      }
    ]
  }
}
