#!/bin/sh
# A push is the one action in this repo that leaves the machine and cannot be
# undone by editing a file. No agent has a reason to take it, and the protocol
# says so — this makes saying so unnecessary.
#
# The human overrides with AKVJ_HUMAN=1:
#   AKVJ_HUMAN=1 git push

if [ "$AKVJ_HUMAN" = "1" ]; then
    exit 0
fi

echo "pre-push: pushing is the human's call." >&2
echo "" >&2
echo "Agents leave work in the working tree; the human reviews and publishes it" >&2
echo "(spec/process/collaboration-protocol.md → Git & Commits)." >&2
echo "" >&2
echo "If you are the human: AKVJ_HUMAN=1 git push" >&2
exit 1
