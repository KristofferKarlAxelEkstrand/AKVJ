{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "ES2022",
		"lib": ["ES2022"],
		"outDir": "dist",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"types": ["node"],
		"moduleResolution": "NodeNext"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "spike"]
}
